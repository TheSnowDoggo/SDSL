class Foo : Object {
    var i: Number = 4;
    var p = "test" + "ttt";
    
    static func foo_2() {
    }
    
    func bar_2() {
    }
}

class Program : Array {
    # constant
    const FILEPATH = "not a filepath";

    # typed static field
    static var X: Number = 3;
    static var Y = 3;
    # untyped static field
    static var Z = 1;
    
    # typed field
    var x: String = "Hello" + ", world!";
    var y = true;
    # untyped field
    var z = 2;
    
    # constructor
    new() { }
    
    # static function
    static func foo() {
        var program := new Program();
    
        var arr: Array = program;
        
        for i in range(10) {
            program.push_back(String.format("test {0}", i));
        }
        
        printf("Hello, world! {0} and {1}\n", X + Y + Z, arr.to_array());
    }
    
    # member function
    func bar(lol: Number, lol2, lol3: String) {
        return x + y + z;
    }
}