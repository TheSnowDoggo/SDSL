class Program : Object {
    static func main() {
        var arr = new MyArray();
        
        arr.push_back("hello");
        
        print_line(arr.to_string());
    }
}

class Vec2 : Object {
    var x: Number;
    var y: Number;
    
    new(x: Number, y: Number) {
        self.x = x;
        self.y = y;
    }
    
    func to_string() -> String {
        return String.format("{{ {}, {} }}", x, y);
    }
}

# Composite User Class
class MyArray : Array {
    func push_back(value: Any) {
        base.push_back(value);
    }
    
    func to_string() {
        return "h" + base.to_string();
    }
}