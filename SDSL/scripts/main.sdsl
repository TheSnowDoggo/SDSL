# implicit using global;
using MathLib;

class Program {
    # Entry point  
    static func main(args) {
        const sw = new Stopwatch();
        sw.start();
        
        var last_seconds = -1;
        while true {
            const elapsed = sw.elapsed();
            
            if elapsed.total_seconds() >= 10 {
                break;
            }
            
            var seconds = elapsed.seconds();
            if seconds != last_seconds {
                println(String.format("{0}:{1}.{2}", 
                    elapsed.hours(),
                    elapsed.minutes(),
                    elapsed.seconds()));
                last_seconds = seconds;
            }
        }
    }
    
    static func map_test() {
        const map: Map = {
            "cheese": 2,
            "poo": {
                "cheese": [2, { 3: 5 }],
            },
        };
        
        map["hello"] = new String(2);
        map[2] = "hello";
        
        if map.erase(2) {
            println(" YaDDsdaDD "
                .replace("y", "n")
                .trim()
                .substr(-1, 9)
                .to_snakecase()
                .to_upper()
            );
        }
        
        println(map);
        
        for key in map {
            println("key: ", key, ", value: ", map[key]);
        }
    }
    
    static func array_test() {
        const arr: Array = ["nah", [" hello  ", "im hiding too!"]];
            
        arr.push_back("s" + new Program());
        
        println(arr[0] = arr[1] = "hello");
        
        if find(arr, "hello") {
            println("WE GOT THAT GOSH DARN HELLO");
            return;
        }
        
        for item: Any in arr {
            print(item);
        }
    }
    
    static func find(arr: Array, s: String) -> Bool {
        for item in arr {
            if typeof(item) == "global::String" && item.trim() == s
                || typeof(item) == "global::Array" && find(item, s) {
                return true;
            }
        }
        return false;
    }
}