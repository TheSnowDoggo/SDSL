class Program {
    static func main(args) {
        const foo: Foo = Foo.create("twilight", "magenta");
        
        printf_rich("<fg={0}>{1}</fg>\n", foo.color, foo);
    }
}

class Foo {
    var name: String;
    var color: String;

    static func create(name: String = "Default name?", color: String = "green") -> Foo {
        const foo: Foo = new Foo();
        foo.name = name;   
        foo.color = color;
    
        return foo;
    }
    
    func to_string() -> String {
        return String.format("Foo(Name: {0})", name);
    }
}