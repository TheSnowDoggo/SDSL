# implicit using global;
#using MathLib;

# File scoped namespace for less nesting
namespace Test;

class Program {
    # Entry point 
    static func main() {
        const arr: Array = ["nah", [" hello  ", "im hiding too!"]];
    
        arr.push_back("s");
        
        if find(arr, "hello") {
            Console.println("WE GOT THAT GOSH DARN HELLO");
            return;
        }
        
        for item: Any in arr {
            Console.print(item);
        }
    }
    
    static func find(arr: Array, s: String) -> Bool {
        for item in arr {
            if typeof(item) == "global::String" && item.trim() == s
                || typeof(item) == "global::Array" && find(item, s) {
                return true;
            }
        }
        return false;
    }
}