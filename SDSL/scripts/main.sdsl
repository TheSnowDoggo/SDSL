namespace Test;

class Vec2 {
    const x: Number;
    const y: Number;
    
    new(x: Number, y: Number) {
        # Explicit self is needed as variables have the same name
        # Usually this can be left out
        self.x = x;
        self.y = y;
    }
    
    func length() {
    }
    
    func to_string() {
        return String.format("({0}, {1})", x, y);
    }
}

class Program {
    static func main() {
        var i = 0;
        while i < 10 {
            if i == 5 {
                break;
            }
            i += 1;
        }
        Console.println(i);
    }
}