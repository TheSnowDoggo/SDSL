# implicit using global;
#using MathLib;

# File scoped namespace for less nesting
namespace Test;

class Program {
    # Entry point  
    static func main() {
        const map: Map = {
            "cheese": 2,
            "poo": {
                "cheese": [2, { 3: 5 }],
            },
        };
        
        map["hello"] = 2;
        map[2] = "hello";
        
        if map.erase(2) {
            Console.println("yay");
        }
        
        Console.println(map);
    }
    
    static func array_test() {
        const arr: Array = ["nah", [" hello  ", "im hiding too!"]];
            
        arr.push_back("s" + new Program());
        
        Console.println(arr[0] = arr[1] = "hello");
        
        if find(arr, "hello") {
            Console.println("WE GOT THAT GOSH DARN HELLO");
            return;
        }
        
        for item: Any in arr {
            Console.print(item);
        }
    }
    
    static func find(arr: Array, s: String) -> Bool {
        for item in arr {
            if typeof(item) == "global::String" && item.trim() == s
                || typeof(item) == "global::Array" && find(item, s) {
                return true;
            }
        }
        return false;
    }
}