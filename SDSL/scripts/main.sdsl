class Person {
    var x = "hello";

    func greet() {
        printf("Hello there, my name is {0}.", x);
    }
}

class Worker : Person {
    func greet() {
        printf("overrriden");
    }
}

class Program {
    static func main(args) {
        var person: Person = new Worker();
        person.x = "helloa";
        
        person.greet();
    }
}