class Program {
    static func main() {
        printl(2 ** 31 - 1);
    }

    static func factorial(n: Number) -> Number {
        assert(Number.is_int(n), "Number must be integer.");

        assert(n >= 0, "Number must be positive.");

        var product := 1;

        for i in range(n, 1) {
            product *= i;
        }

        return product;
    }

    static func fibonacci(n: Number) -> Array {
        assert(Number.is_int(n), "Number must be integer.");

        if n < 0 {
            return [];
        }

        if n == 0 {
            return [0];
        }

        var numbers := [0, 1];

        for i in range(2, n + 1) {
            numbers.push_back(numbers[i - 1] + numbers[i - 2]);
        }

        return numbers;
    }
}