class Program {
    static func main() {
        var game = new TicTacToe();
        game.run_game();
    }
}

enum CellType {
    Empty,
    Naught,
    Cross,
}

class Point {
    var x: Number;
    var y: Number;

    new(x: Number, y: Number) {
        self.x = x;
        self.y = y;
    }

    func to_string() -> String {
        return String.format("({}, {})", x, y);
    }
}

class TicTacToe {
    var board: Array;
    var current_player: Number = CellType.Naught;

    func setup() {
        board = new Array(9, CellType.Empty);

        print_board();
    }

    func run_game() {
        setup();

        while true {
            var point := input_valid_point();

            board[point_to_index(point.x, point.y)] = current_player;

            clear_console();
            print_board();

            if has_player_won(point.x, point.y) {
                break;
            }

            swap_player();
        }

        printf_rich("<fg=cyan>Player {} won!", CellType.Names[current_player]);
    }

    func swap_player() {
        switch current_player {
            CellType.Naught: {
                current_player = CellType.Cross;
            }
            CellType.Cross: {
                current_player = CellType.Naught;
            }
        }
    }

    static func get_cell_visual(cell_type: Number) -> String {
        switch cell_type {
            CellType.Empty: {
                return "  ";
            }
            CellType.Naught: {
                return "()";
            }
            CellType.Cross: {
                return "><";
            }
            default: {
                throw("Got invalid cell type: " + cell_type);
            }
        }
    }

    func print_board() {
        var i := 0;

        for y in range(3) {
            print("|");

            for x in range(3) {
                print(get_cell_visual(board[i]));
                i += 1;
            }

            printl("|");
        }
    }

    func print_error(msg: String) {
        printf_rich("<fg=red>Error: {}\n", msg);
    }

    func input_valid_dim(msg: String) -> Number {
        while true {
            print(msg);

            var input := readl();

            if input.is_whitespace() {
                print_error("Input was empty!");
                continue;
            }

            var x := Number.parse(input);

            if not x {
                print_error(String.format("Input '{}' was not a valid number.", input));
                continue;
            }

            if not (Number.is_int(x) and x >= 0 and x < 3) {
                print_error(String.format("Coordinate '{}' must an integer between 0 - 2 (inclusive).", x));
                continue;
            }

            return x;
        }
    }

    func input_valid_point() -> Point {
        while true {
            var x := input_valid_dim("Enter x-coordinate: ");

            var y := input_valid_dim("Enter y-coordinate: ");

            var index := point_to_index(x, y);

            if board[index] != CellType.Empty {
                print_error(String.format("Coordinate '({}, {})' was invalid, the cell was occupied.", x, y));
                continue;
            }

            return new Point(x, y);
        }
    }

    func point_to_index(x: Number, y: Number) -> Number {
        return y * 3 + x;
    }

    func has_player_won_row(y: Number) -> Bool {
        for x in range(3) {
            if board[point_to_index(x, y)] != current_player {
                return false;
            }
        }
        return true;
    }

    func has_player_won_column(x: Number) -> Bool {
        for y in range(3) {
            if board[point_to_index(x, y)] != current_player {
                return false;
            }
        }
        return true;
    }

    func has_player_won_diagonal(x: Number, y: Number) -> Bool {
        var index := point_to_index(x, y);

        switch index {
            # top left, middle, bottom right
            # check SE diagonol
            0: 4: 8: {
                return board[0] == current_player
                    and board[4] == current_player
                    and board[8] == current_player;
            }
        }

        switch index {
            # top right, middle, bottom left
            # check SW diagonol
            2: 4: 6: {
                return board[2] == current_player
                    and board[4] == current_player
                    and board[6] == current_player;
            }
        }

        return false;
    }

    func has_player_won(x: Number, y: Number) -> Bool {
        return has_player_won_column(x)
            or has_player_won_row(y)
            or has_player_won_diagonal(x, y);
    }
}