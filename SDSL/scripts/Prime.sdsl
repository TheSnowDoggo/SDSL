namespace MathLib;

class Prime {
    static func get_primes(n: Number) -> Array {
        if n <= 1 {
            return [];
        }
        
        const primes: Array = [2];
        
        for i in range(3, n + 1, 2) {
            const end = Math.sqrt(i);
            
            var is_prime: Bool = true;
            
            for prime in primes {
                if prime > end {
                    break;
                }
                
                if i % prime == 0 {
                    is_prime = false;
                    break;
                }
            }
            
            if is_prime {
                primes.push_back(i);
            }
        }
        
        return primes;
    }
}